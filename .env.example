# Optional: leave empty to use the deterministic diagnostic engine only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Safe by default: submitted requests are analysed, not executed.
TRACEAID_ENABLE_LIVE_PROBES=false
TRACEAID_REQUEST_TIMEOUT_SECONDS=8
TRACEAID_MAX_RESPONSE_BYTES=262144
TRACEAID_ALLOWED_ORIGINS=http://localhost:8000
TRACEAID_LOG_LEVEL=INFO
